# =================================================================
# Legal Clarity Environment Configuration
# =================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=15

# Privacy & Ephemeral Document Processing
# Time in hours before ephemeral documents and cached indexes are cleaned up
DOCUMENT_TTL_HOURS=2

# AI Provider Configuration
# Supported providers: gemini, demo
# If GEMINI_API_KEY is unset or empty, provider automatically falls back to 'demo'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Evidence Verification Threshold (0.0 to 1.0)
EVIDENCE_VERIFICATION_THRESHOLD=0.85
